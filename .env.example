# Copy to .env for local development. Never commit .env.
APP_ENV=dev
DATABASE_URL=postgresql://tp:tp@localhost:5432/tp_dev
# Any random string locally. In production this is a Databricks secret.
IDENTITY_KEY=dev-only-change-me
# Dev only: act as this user when no identity header is sent. Use a fictitious address.
DEV_USER_EMAIL=dev.admin@example.test
# Key hash of the first administrator (see tools/hash_email.py).
BOOTSTRAP_ADMIN_HASHES=
